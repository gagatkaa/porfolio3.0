---
export interface Props {
  title: string;
  index: number;
}

const { title, index } = Astro.props;
---

<button class="project-card" data-project-index={index} aria-label={`View project: ${title}`} tabindex="0">
  <div class="file-icon">
    <svg viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="2" width="44" height="52" rx="2" stroke="currentColor" stroke-width="1.5" fill="none" />
      <path d="M32 2v12h12" stroke="currentColor" stroke-width="1.5" fill="none" />
      <line x1="14" y1="24" x2="34" y2="24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <line x1="14" y1="32" x2="34" y2="32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <line x1="14" y1="40" x2="28" y2="40" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </div>
  <span class="file-name">{title}</span>
</button>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px;
    border: 1px solid transparent;
    border-radius: 4px;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
    cursor: pointer;
    background: transparent;
    color: var(--text-primary);
    text-align: center;
    font-family: var(--font-mono);
  }

  .project-card:hover,
  .project-card:focus-visible {
    border-color: var(--accent-purple);
    background: rgba(179, 0, 255, 0.05);
    transform: translateY(-2px);
  }

  .file-icon {
    width: 48px;
    height: 56px;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .project-card:hover .file-icon {
    color: var(--accent-purple);
  }

  .file-name {
    font-size: 0.75rem;
    color: var(--text-secondary);
    max-width: 100px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .project-card {
      padding: 12px;
    }
    .file-icon {
      width: 40px;
      height: 48px;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import mePhoto from '../assets/me.png';
import { socialLinks, getSocialIcon } from '../data/social';
import { withBase } from '../utils/url';

const cvUrl = withBase('documents/Tomaszewska_Agata_CV.pdf');
const resolvedSocials = socialLinks.map(s => ({
  ...s,
  url: s.label === 'cv' ? cvUrl : s.url,
  icon: getSocialIcon(s.label),
}));
---

<section class="hero-header" id="hero-header">
  <div class="hero-grid">
    <div class="hero-intro">
      <h1 class="hero-name" id="hero-name-display">
        <span class="name-line name-line-1" data-text="AGATA">AGATA</span>
        <span class="name-line name-line-2" data-text="TOMASZEWSKA">TOMASZEWSKA</span>
      </h1>
      <div class="hero-title-line" id="hero-title-line">
        <span class="title-bracket">[</span>
        <span class="title-text" id="title-text"></span>
        <span class="title-bracket">]</span>
      </div>
      <p class="hero-intro-text" id="hero-intro-text">
        UI/UX designer and frontend developer from Poland &mdash; I design digital products in Figma and build them in code, with a love for motion and creative tech. Currently at Howest DEVINE.
      </p>
      <nav class="hero-socials" id="hero-socials" aria-label="Find me on">
        {resolvedSocials.map(s => (
          <a class="hero-social" href={s.url} target="_blank" rel="noopener noreferrer">
            <span class="hero-social-icon" aria-hidden="true" set:html={s.icon} />
            <span class="hero-social-label">{s.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <figure class="hero-photo-figure" id="hero-photo">
      <div class="hero-photo-window">
        <div class="hero-photo-titlebar">
          <span class="terminal-dots">
            <span class="dot close"></span>
            <span class="dot minimize"></span>
            <span class="dot maximize"></span>
          </span>
          <span class="hero-photo-filename">me.png</span>
        </div>
        <Image
          src={mePhoto}
          alt="Portrait of Agata Tomaszewska"
          class="hero-photo-img"
          width={380}
          height={475}
          loading="eager"
        />
      </div>
      <figcaption class="hero-photo-caption">agata@portfolio:~$ whoami</figcaption>
    </figure>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const nameDisplay = document.getElementById('hero-name-display');
  const titleLine = document.getElementById('hero-title-line');
  const titleText = document.getElementById('title-text');
  const introText = document.getElementById('hero-intro-text');
  const socials = document.getElementById('hero-socials');
  const photo = document.getElementById('hero-photo');

  function typeSubtitle(el, text, speed) {
    el.textContent = '';
    const cursor = document.createElement('span');
    cursor.className = 'typing-cursor';
    cursor.textContent = '▊';
    el.parentNode.insertBefore(cursor, el.nextSibling);
    function tick() {
      if (el.textContent.length < text.length) {
        el.textContent += text[el.textContent.length];
        setTimeout(tick, speed);
      } else {
        cursor.style.animation = 'none';
        cursor.style.opacity = '0';
      }
    }
    setTimeout(tick, speed);
  }

  function revealInstantly() {
    [nameDisplay, titleLine, introText, socials, photo].forEach(el => {
      el.style.opacity = '1';
    });
  }

  let headerAnimated = false;

  function animateHeader() {
    if (headerAnimated) return;
    headerAnimated = true;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) {
      titleText.textContent = 'UI/UX Designer & Developer';
      revealInstantly();
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.fromTo(nameDisplay, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8 })
      .fromTo('.name-line-1', { x: -30 }, { x: 0, duration: 0.5 }, '-=0.4')
      .fromTo('.name-line-2', { x: 30 }, { x: 0, duration: 0.5 }, '-=0.3')
      .fromTo(titleLine, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.4 }, '-=0.2')
      .call(() => { typeSubtitle(titleText, 'UI/UX Designer & Developer', 55); }, [], '>')
      .fromTo(introText, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power3.out' }, '-=0.2')
      .fromTo(socials, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power3.out' }, '-=0.3')
      .fromTo(photo, { opacity: 0, x: 24, scale: 0.96 }, { opacity: 1, x: 0, scale: 1, duration: 0.6, ease: 'power3.out' }, '-=0.5');
  }

  if (document.documentElement.classList.contains('booted')) {
    animateHeader();
  } else {
    document.addEventListener('boot-complete', animateHeader, { once: true });
  }

  setTimeout(() => {
    if (headerAnimated) return;
    headerAnimated = true;
    titleText.textContent = 'UI/UX Designer & Developer';
    revealInstantly();
  }, 4000);
</script>

<style>
  .hero-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(32px, 5vw, 56px);
    overflow: hidden;
  }

  #hero-name-display,
  #hero-title-line,
  #hero-intro-text,
  #hero-socials,
  #hero-photo {
    opacity: 0;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
    max-width: 1040px;
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero-intro {
    text-align: left;
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 16px;
  }

  .name-line {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    position: relative;
  }

  .hero-title-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  .title-bracket {
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: var(--accent-purple);
    font-weight: 300;
  }

  .title-text {
    font-size: clamp(0.85rem, 2vw, 1.2rem);
    color: var(--accent-green);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero-intro-text {
    margin: 0 0 22px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    line-height: 1.7;
    letter-spacing: 0.01em;
    max-width: 46ch;
  }

  .hero-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }

  .hero-social {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-3xs);
    color: var(--text-dim);
    text-decoration: none;
    letter-spacing: 0.04em;
    border: 1px solid transparent;
    padding: 4px 8px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .hero-social:hover,
  .hero-social:focus-visible {
    color: var(--accent-green);
    border-color: var(--border-light);
    background: var(--bg-secondary);
    outline: none;
  }

  .hero-social-icon {
    display: inline-flex;
    align-items: center;
    color: var(--accent-purple);
    line-height: 0;
  }

  .hero-social-icon svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .hero-social:hover .hero-social-icon {
    color: var(--accent-green);
  }

  /* ---- portrait window ---- */
  .hero-photo-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    justify-self: end;
    width: 100%;
  }

  .hero-photo-window {
    width: 100%;
    max-width: 300px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    box-shadow:
      0 0 0 1px var(--border-light),
      0 16px 48px rgba(0, 0, 0, 0.45);
    transition: border-color 0.3s, box-shadow 0.3s;
    overflow: hidden;
  }

  .hero-photo-window:hover {
    border-color: var(--accent-purple);
    box-shadow:
      0 0 0 1px var(--border-light),
      0 0 28px var(--accent-purple-glow),
      0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .light-mode .hero-photo-window {
    box-shadow:
      0 0 0 1px var(--border-light),
      0 16px 48px rgba(0, 0, 0, 0.16);
  }

  .hero-photo-titlebar {
    display: flex;
    align-items: center;
    height: var(--titlebar-height);
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border);
    padding: 0 12px;
    gap: 8px;
    user-select: none;
  }

  .hero-photo-filename {
    color: var(--text-dim);
    font-size: var(--fs-xs);
    flex: 1;
    text-align: left;
    letter-spacing: 0.02em;
  }

  .hero-photo-img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(35%) contrast(1.05);
    transition: filter 0.4s, transform 0.4s;
  }

  .hero-photo-window:hover .hero-photo-img {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.02);
  }

  .hero-photo-caption {
    font-size: var(--fs-3xs);
    color: var(--text-dim);
    letter-spacing: 0.03em;
    font-family: var(--font-mono);
  }

  .typing-cursor {
    color: var(--accent-green);
    animation: blink-cursor 1s step-end infinite;
    margin-left: 2px;
  }

  @keyframes blink-cursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .typing-cursor {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      justify-items: center;
      text-align: center;
    }

    .hero-intro {
      text-align: center;
    }

    .hero-title-line {
      justify-content: center;
    }

    .hero-intro-text {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-socials {
      justify-content: center;
      gap: 8px;
    }

    .hero-social {
      border-color: var(--border-color);
      background: var(--bg-surface);
      padding: 7px 12px;
    }

    .hero-social:hover,
    .hero-social:focus-visible {
      border-color: var(--accent-purple);
    }

    .hero-photo-figure {
      justify-self: center;
    }
  }

  @media (max-width: 640px) {
    .hero-header {
      padding-top: 48px;
      padding-bottom: 40px;
    }

    .hero-grid {
      padding: 0 16px;
      gap: 28px;
    }

    .hero-photo-window {
      max-width: 240px;
    }
  }
</style>
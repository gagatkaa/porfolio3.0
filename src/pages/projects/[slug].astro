---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => {
    const slug = project.id.replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { project },
    };
  });
}

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props as Props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} · Agata Tomaszewska`}>
  <div class="detail-page section">
    <a href="/" class="back-link">← back to desktop</a>

    <div class="terminal-window detail-window">
      <div class="terminal-titlebar">
        <span class="terminal-dots">
          <span class="dot close"></span>
          <span class="dot minimize"></span>
          <span class="dot maximize"></span>
        </span>
        <span class="terminal-title">{project.data.title} — details</span>
      </div>
      <div class="terminal-body">
        {project.data.coverImage && (
          <div class="detail-cover">
            <img src={project.data.coverImage} alt="" />
          </div>
        )}
        <div class="detail-meta">
          <div class="meta-row"><span class="field-label">role</span> <span class="field-value">{project.data.role}</span></div>
          <div class="meta-row"><span class="field-label">year</span> <span class="field-value">{project.data.year}</span></div>
          <div class="meta-row"><span class="field-label">tools</span> <span class="field-value">{project.data.tools.join(', ')}</span></div>
        </div>

        {project.data.externalLink && (
          <a href={project.data.externalLink} target="_blank" rel="noopener noreferrer" class="ext-link">[ view live ]</a>
        )}

        <div class="detail-content">
          <Content />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .detail-page {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 20px;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .back-link:hover {
    color: var(--accent-green);
  }

  .detail-cover {
    margin-bottom: 20px;
    border: 1px solid var(--border-color);
  }

  .detail-cover img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(40%) contrast(1.1);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .meta-row {
    font-size: 0.8rem;
  }

  .field-label {
    color: var(--accent-green);
    display: inline;
  }

  .field-value {
    color: var(--text-primary);
  }

  .ext-link {
    display: inline-block;
    margin-bottom: 20px;
    font-size: 0.85rem;
  }

  .detail-content {
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .detail-content h2 {
    color: var(--accent-purple);
    font-size: 1rem;
    font-weight: 500;
    margin: 28px 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-content h3 {
    color: var(--accent-green);
    font-size: 0.9rem;
    font-weight: 500;
    margin: 24px 0 10px;
  }

  .detail-content p {
    margin-bottom: 12px;
    color: var(--text-secondary);
  }

  .detail-content ul,
  .detail-content ol {
    padding-left: 20px;
    margin-bottom: 12px;
    color: var(--text-secondary);
  }

  .detail-content li {
    margin-bottom: 4px;
  }

  .detail-content strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  .detail-content a {
    color: var(--accent-purple);
    text-decoration: underline;
  }

  .detail-content code {
    background: var(--bg-tertiary);
    padding: 1px 4px;
    font-size: 0.8em;
    color: var(--accent-green);
  }
</style>

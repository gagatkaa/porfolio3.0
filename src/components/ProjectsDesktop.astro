---
import { getCollection, render } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectWindow from './ProjectWindow.astro';

const projects = await getCollection('projects');

const rendered = [];
for (let i = 0; i < projects.length; i++) {
  const p = projects[i];
  const { Content } = await render(p);
  rendered.push({
    slug: p.id.replace(/\.(md|mdx)$/, ''),
    title: p.data.title,
    shortDescription: p.data.shortDescription,
    role: p.data.role,
    year: p.data.year,
    tools: p.data.tools,
    coverImage: p.data.coverImage,
    externalLink: p.data.externalLink,
    Content,
  });
}

const projectsData = rendered.map(({ Content, ...rest }) => rest);
---

<section class="projects-section section hidden-section" id="projects-section">
  <h2 class="section-heading">
    <span class="heading-accent">&gt;</span> projects
    <span class="heading-count">{projectsData.length} files</span>
  </h2>

  <div class="projects-grid" id="projects-grid">
    {projectsData.map((project, index) => (
      <ProjectCard
        title={project.title}
        shortDescription={project.shortDescription}
        tools={project.tools}
        coverImage={project.coverImage}
        index={index}
      />
    ))}
  </div>
</section>

<ProjectWindow count={projectsData.length} />

{
  rendered.map((p, index) => (
    <template id={`project-template-${index}`}>
      <div class="case-study">
        {p.coverImage && (
          <div class="case-cover">
            <img src={p.coverImage} alt="" loading="lazy" />
          </div>
        )}
        <div class="case-meta">
          <div class="meta-row"><span class="field-label">role</span> <span class="field-value">{p.role}</span></div>
          <div class="meta-row"><span class="field-label">year</span> <span class="field-value">{p.year}</span></div>
          <div class="meta-row meta-tools"><span class="field-label">tools</span> <span class="field-value">{p.tools.map(t => <span class="tool-tag">{t}</span>)}</span></div>
        </div>
        {p.externalLink && (
          <a href={p.externalLink} target="_blank" rel="noopener noreferrer" class="ext-link">[ view live ]</a>
        )}
        <div class="case-content">
          <p.Content />
        </div>
        <a class="case-footer-link" href={`/projects/${p.slug}`}>open full page: /projects/{p.slug}</a>
      </div>
    </template>
  ))
}

<script define:vars={{ pd: projectsData }}>window.__pd = pd;</script>

<script>
  import gsap from 'gsap';

  const projectsData = window.__pd;

  const overlay = document.getElementById('project-window-overlay');
  const windowEl = document.getElementById('project-window');
  const titleEl = document.getElementById('window-title');
  const bodyEl = document.getElementById('window-body');
  const closeBtn = document.getElementById('window-close-btn');
  const dragHandle = document.getElementById('window-drag-handle');
  const prevBtn = document.getElementById('window-prev-btn');
  const nextBtn = document.getElementById('window-next-btn');
  const counterEl = document.getElementById('window-counter');
  const section = document.getElementById('projects-section');
  const grid = document.getElementById('projects-grid');

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let isOpen = false;
  let isDragging = false;
  let dragStartX, dragStartY, winStartX, winStartY;
  let hasAnimated = false;
  let currentIndex = 0;

  /* ---- stagger on reveal ---- */
  if (section && !prefersReduced) {
    const observer = new MutationObserver(() => {
      if (!section.classList.contains('hidden-section') && !hasAnimated) {
        hasAnimated = true;
        observer.disconnect();
        const cards = grid.querySelectorAll('.project-card');
        gsap.fromTo(
          cards,
          { opacity: 0, y: 40, scale: 0.96 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.55,
            stagger: { each: 0.12, from: 'start' },
            ease: 'power3.out',
            onComplete: () => {
              cards.forEach(c => {
                c.style.opacity = '';
                c.style.transform = '';
              });
            },
          }
        );
      }
    });
    observer.observe(section, { attributes: true, attributeFilter: ['class'] });
  }

  /* ---- card click ---- */
  const allCards = () => document.querySelectorAll('.project-card');
  function bindCards() {
    allCards().forEach((card) => {
      card.addEventListener('click', () => {
        const index = parseInt(card.dataset.projectIndex);
        openProject(index);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const index = parseInt(card.dataset.projectIndex);
          openProject(index);
        }
      });
    });
  }
  bindCards();

  function openProject(index) {
    const p = projectsData[index];
    if (!p) return;

    const card = allCards()[index];

    if (!prefersReduced && card) {
      gsap.to(card, {
        scale: 0.95,
        opacity: 0.6,
        duration: 0.15,
        ease: 'power2.in',
        onComplete: () => {
          gsap.set(card, { clearProps: 'all' });
          showWindow(index);
        },
      });
    } else {
      showWindow(index);
    }
  }

  function showWindow(index) {
    currentIndex = index;
    const p = projectsData[index];
    if (!p) return;

    titleEl.textContent = p.title;

    const tpl = document.getElementById('project-template-' + index);
    bodyEl.innerHTML = tpl ? tpl.innerHTML : '';
    if (counterEl) counterEl.textContent = `${index + 1} / ${projectsData.length}`;

    overlay.classList.add('visible');

    if (!prefersReduced) {
      gsap.fromTo(windowEl,
        { scale: 0.7, opacity: 0, y: 30 },
        { scale: 1, opacity: 1, y: 0, duration: 0.35, ease: 'back.out(1.5)' }
      );
    }

    isOpen = true;
    resetWindowPosition();
    document.addEventListener('keydown', handleKeydown);
    overlay.focus();
    document.body.style.overflow = 'hidden';
  }

  function navigate(offset) {
    if (!isOpen) return;
    const next = (currentIndex + offset + projectsData.length) % projectsData.length;
    if (!prefersReduced) {
      gsap.to(windowEl, {
        x: -offset * 24,
        opacity: 0,
        duration: 0.18,
        ease: 'power2.in',
        onComplete: () => {
          windowEl.style.transform = '';
          showWindow(next);
          gsap.fromTo(windowEl,
            { x: offset * 24, opacity: 0 },
            { x: 0, opacity: 1, duration: 0.22, ease: 'power2.out' }
          );
        },
      });
    } else {
      showWindow(next);
    }
  }

  function closeProject() {
    if (!isOpen) return;

    document.removeEventListener('keydown', handleKeydown);
    document.body.style.overflow = '';

    if (!prefersReduced) {
      gsap.to(windowEl, {
        scale: 0.7,
        opacity: 0,
        y: 30,
        duration: 0.25,
        ease: 'power2.in',
        onComplete: () => {
          overlay.classList.remove('visible');
          windowEl.style.transform = '';
        },
      });
    } else {
      overlay.classList.remove('visible');
    }

    isOpen = false;
  }

  function handleKeydown(e) {
    if (e.key === 'Escape') {
      closeProject();
      return;
    }
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      navigate(-1);
      return;
    }
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      navigate(1);
      return;
    }
    if (e.key === 'Tab') {
      const focusable = overlay.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  closeBtn.addEventListener('click', closeProject);
  if (prevBtn) prevBtn.addEventListener('click', () => navigate(-1));
  if (nextBtn) nextBtn.addEventListener('click', () => navigate(1));
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeProject();
  });

  function resetWindowPosition() {
    windowEl.style.left = '';
    windowEl.style.top = '';
    windowEl.style.transform = '';
  }

  dragHandle.addEventListener('mousedown', (e) => {
    if (window.innerWidth <= 640) return;
    e.preventDefault();
    isDragging = true;
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    const rect = windowEl.getBoundingClientRect();
    winStartX = rect.left;
    winStartY = rect.top;
  });

  document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    const dx = e.clientX - dragStartX;
    const dy = e.clientY - dragStartY;
    windowEl.style.left = `${winStartX + dx}px`;
    windowEl.style.top = `${winStartY + dy}px`;
    windowEl.style.transform = 'none';
  });

  document.addEventListener('mouseup', () => {
    isDragging = false;
  });

  dragHandle.addEventListener('touchstart', (e) => {
    if (window.innerWidth <= 640) return;
    const touch = e.touches[0];
    isDragging = true;
    dragStartX = touch.clientX;
    dragStartY = touch.clientY;
    const rect = windowEl.getBoundingClientRect();
    winStartX = rect.left;
    winStartY = rect.top;
  }, { passive: true });

  document.addEventListener('touchmove', (e) => {
    if (!isDragging) return;
    const touch = e.touches[0];
    const dx = touch.clientX - dragStartX;
    const dy = touch.clientY - dragStartY;
    windowEl.style.left = `${winStartX + dx}px`;
    windowEl.style.top = `${winStartY + dy}px`;
    windowEl.style.transform = 'none';
  }, { passive: true });

  document.addEventListener('touchend', () => {
    isDragging = false;
  }, { passive: true });
</script>

<style>
  .projects-section {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .section-heading {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 24px;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .heading-accent {
    color: var(--accent-green);
  }

  .heading-count {
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

---
import { extras, extraGroups } from '../data/extras';
---

<section class="extras-block">
  {extraGroups.map(group => {
    const items = extras.filter(e => e.type === group.type);
    return (
      <div class="extras-group">
        <h3 class="extras-heading">
          <span class="heading-accent">&gt;</span> extras / {group.label}
          <span class="heading-count">{items.length} items</span>
        </h3>
        <div class="extras-grid">
          {items.map(item => (
            <figure class="extra-tile">
              <div class="extra-thumb">
                {item.image ? (
                  <img src={item.image} alt={item.title} loading="lazy" />
                ) : (
                  <span class="extra-placeholder" aria-hidden="true">
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="2" y="2" width="44" height="44" rx="2" stroke="currentColor" stroke-width="1.5" fill="none" />
                      <path d="M12 12h24M12 20h24M12 28h24M12 36h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                  </span>
                )}
              </div>
              <figcaption class="extra-caption">
                <span class="extra-title">{item.title}.{group.type === '3d' ? 'obj' : 'png'}</span>
                {item.note && <span class="extra-note">{item.note}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    );
  })}
</section>

<style>
  .extras-block {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .extras-heading {
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 16px;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .heading-accent {
    color: var(--accent-green);
  }

  .heading-count {
    font-size: var(--fs-2xs);
    color: var(--text-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .extras-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 14px;
  }

  .extra-tile {
    margin: 0;
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .extra-tile:hover {
    border-color: var(--accent-purple);
    box-shadow: 0 0 18px var(--accent-purple-glow);
  }

  .extra-thumb {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .extra-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(50%) contrast(1.1);
    transition: filter 0.3s, transform 0.3s;
  }

  .extra-tile:hover .extra-thumb img {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.03);
  }

  .extra-placeholder {
    display: inline-flex;
    color: var(--text-dim);
    opacity: 0.4;
  }

  .extra-placeholder svg {
    width: 32px;
    height: 32px;
  }

  .extra-caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
  }

  .extra-title {
    font-size: var(--fs-2xs);
    color: var(--accent-green);
    letter-spacing: 0.03em;
  }

  .extra-note {
    font-size: var(--fs-3xs);
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .extras-grid {
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 10px;
    }
  }
</style>
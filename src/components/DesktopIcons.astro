---
import { getDesktopIcon } from '../data/desktopIcons';

const shortcuts = [
  {
    id: 'projects-section',
    label: 'projects',
    icon: getDesktopIcon('projects'),
  },
  {
    id: 'about-section',
    label: 'about',
    icon: getDesktopIcon('about'),
  },
  {
    id: 'contact-section',
    label: 'contact',
    icon: getDesktopIcon('contact'),
  },
  {
    id: 'hero-section',
    label: 'terminal',
    icon: getDesktopIcon('terminal'),
  },
];
---

<div class="desktop-icons" id="desktop-icons" aria-label="Desktop shortcuts">
  {shortcuts.map(s => (
    <button class="desktop-shortcut" data-section={s.id} aria-label={`Open ${s.label}`}>
      <span class="desktop-shortcut-icon" aria-hidden="true" set:html={s.icon} />
      <span class="desktop-shortcut-label">{s.label}</span>
    </button>
  ))}
</div>

<script>
  const icons = document.getElementById('desktop-icons');
  if (icons) {
    const shortcutEls = icons.querySelectorAll('.desktop-shortcut');

    function openShortcut(id) {
      const revealFn = window.revealSection;
      if (revealFn) {
        revealFn(id);
      } else {
        const el = document.getElementById(id);
        if (el) {
          if (id === 'hero-section') {
            el.style.display = 'block';
          } else {
            el.classList.remove('hidden-section');
          }
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    shortcutEls.forEach(el => {
      el.addEventListener('click', () => openShortcut(el.dataset.section));
    });

    const showIcons = () => {
      icons.classList.add('visible');
    };

    document.addEventListener('boot-complete', showIcons, { once: true });
    setTimeout(showIcons, 2500);
  }
</script>

<style>
  .desktop-icons {
    position: fixed;
    left: 16px;
    top: 50%;
    transform: translateY(-50%) translateX(-8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    z-index: 4100;
    padding: 10px 6px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s;
  }

  .desktop-icons.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%) translateX(0);
  }

  .desktop-shortcut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 6px 4px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font-family: var(--font-mono);
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    min-width: 64px;
  }

  .desktop-shortcut:hover,
  .desktop-shortcut:focus-visible {
    background: rgba(179, 0, 255, 0.08);
    border-color: var(--border-light);
    color: var(--text-primary);
    outline: none;
  }

  .desktop-shortcut-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--accent-purple);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    line-height: 0;
    transition: color 0.15s, box-shadow 0.15s;
  }

  .desktop-shortcut-icon svg {
    display: block;
  }

  .desktop-shortcut:hover .desktop-shortcut-icon,
  .desktop-shortcut:focus-visible .desktop-shortcut-icon {
    color: var(--accent-green);
    box-shadow: 0 0 12px var(--accent-green-glow);
  }

  .desktop-shortcut-label {
    font-size: var(--fs-3xs);
    letter-spacing: 0.04em;
    text-transform: none;
    max-width: 64px;
    text-align: center;
    line-height: 1.3;
  }

  @media (max-width: 1099px) {
    .desktop-icons {
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      flex-direction: row;
      justify-content: space-around;
      transform: translateY(8px);
      gap: 4px;
      padding: 8px 12px 6px;
      padding-bottom: calc(6px + env(safe-area-inset-bottom, 0));
      background: var(--bg-tertiary);
      border: none;
      border-top: 1px solid var(--border);
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.4);
    }

    .desktop-icons.visible {
      transform: translateY(0);
    }

    .desktop-shortcut[data-section="hero-section"] {
      display: none;
    }

    .desktop-shortcut {
      min-width: 56px;
      padding: 4px;
    }

    .desktop-shortcut-icon {
      width: 32px;
      height: 32px;
    }

    .desktop-shortcut-icon svg {
      width: 20px;
      height: 20px;
    }

    .desktop-shortcut-label {
      max-width: 56px;
    }
  }

  @media (max-width: 640px) {
    .desktop-icons {
      gap: 4px;
      padding: 6px 8px 4px;
      padding-bottom: calc(4px + env(safe-area-inset-bottom, 0));
    }
  }
</style>
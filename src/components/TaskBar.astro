<footer class="taskbar" id="taskbar">
  <div class="taskbar-left">
    <button class="start-btn" id="start-btn" aria-label="Start menu">
      <span class="start-icon">▲</span>
      <span class="start-label">Start</span>
    </button>
  </div>
  <div class="taskbar-right">
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
      <span id="theme-icon">☀</span>
    </button>
    <span class="taskbar-clock" id="clock">00:00</span>
  </div>
</footer>

<nav class="start-menu" id="start-menu" aria-label="Start menu">
  <div class="start-menu-header">◆ Portfolio</div>
  <button class="start-item" data-section="hero-section">Terminal</button>
  <button class="start-item" data-section="about-section">About</button>
  <button class="start-item" data-section="projects-section">Projects</button>
  <button class="start-item" data-section="contact-section">Contact</button>
  <div class="start-menu-footer">Agata Tomaszewska · Digital Designer</div>
</nav>

<script>
  const startBtn = document.getElementById('start-btn');
  const startMenu = document.getElementById('start-menu');
  const clockEl = document.getElementById('clock');
  const startItems = startMenu.querySelectorAll('[data-section]');
  const themeToggle = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-icon');

  function updateClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    clockEl.textContent = `${h}:${m}`;
  }
  updateClock();
  setInterval(updateClock, 10000);

  function toggleStart(e) {
    e.stopPropagation();
    startMenu.classList.toggle('visible');
  }

  function closeStart() {
    startMenu.classList.remove('visible');
  }

  function setTheme(mode) {
    if (mode === 'light') {
      document.documentElement.classList.add('light-mode');
      themeIcon.textContent = '☾';
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.remove('light-mode');
      themeIcon.textContent = '☀';
      localStorage.setItem('theme', 'dark');
    }
  }

  if (localStorage.getItem('theme') === 'light') {
    themeIcon.textContent = '☾';
  }

  themeToggle.addEventListener('click', () => {
    const isLight = document.documentElement.classList.contains('light-mode');
    setTheme(isLight ? 'dark' : 'light');
  });

  startBtn.addEventListener('click', toggleStart);

  document.addEventListener('click', (e) => {
    if (!startMenu.contains(e.target) && e.target !== startBtn) {
      closeStart();
    }
  });

  startItems.forEach((item) => {
    item.addEventListener('click', () => {
      closeStart();
      const sectionId = item.dataset.section;
      const revealFn = window.revealSection;
      if (revealFn) {
        revealFn(sectionId);
      } else {
        const el = document.getElementById(sectionId);
        if (el) {
          el.classList.remove('hidden-section');
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>


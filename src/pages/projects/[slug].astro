---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => {
    const slug = project.id.replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { project },
    };
  });
}

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props as Props;
const { Content } = await render(project);

const allProjects = await getCollection('projects');
const ordered = [
  ...allProjects.filter(p => p.data.category === 'dev-web'),
  ...allProjects.filter(p => p.data.category === 'design-motion'),
];
const currentIndex = ordered.findIndex(p => p.id === project.id);
const slugOf = (entry: CollectionEntry<'projects'>) => entry.id.replace(/\.(md|mdx)$/, '');
const hasSiblings = ordered.length > 1;
const prevProject = hasSiblings ? ordered[(currentIndex - 1 + ordered.length) % ordered.length] : undefined;
const nextProject = hasSiblings ? ordered[(currentIndex + 1) % ordered.length] : undefined;

const detailHero = project.data.detailHero ?? project.data.coverImage;
const projectVideos = import.meta.glob('../../assets/projects/**/*.mp4', {
  eager: true,
  import: 'default',
}) as Record<string, string>;
const heroVideo = project.data.heroVideo ? projectVideos[project.data.heroVideo] : undefined;
---

<BaseLayout title={`${project.data.title} · Agata Tomaszewska`}>
  <div class="detail-page section">
    <a href="/" class="back-link">← back to desktop</a>

    <div class="terminal-window detail-window">
      <div class="terminal-titlebar">
        <span class="terminal-dots">
          <span class="dot close"></span>
          <span class="dot minimize"></span>
          <span class="dot maximize"></span>
        </span>
        <span class="terminal-title">{project.data.title} — details</span>
      </div>
      <div class="terminal-body detail-body">
        {project.data.heroVideo && heroVideo ? (
          <div class="detail-cover detail-cover-video">
            <video src={heroVideo} autoplay muted loop playsinline preload="metadata" />
          </div>
        ) : (
          detailHero && (
            <div class="detail-cover">
              <Image src={detailHero} alt="" />
            </div>
          )
        )}
        <div class="detail-meta">
          <div class="meta-row"><span class="field-label">role</span> <span class="field-value">{project.data.role}</span></div>
          <div class="meta-row"><span class="field-label">year</span> <span class="field-value">{project.data.year}</span></div>
          <div class="meta-row"><span class="field-label">tools</span> <span class="field-value">{project.data.tools.join(', ')}</span></div>
        </div>

        {project.data.externalLink && (
          <a href={project.data.externalLink} target="_blank" rel="noopener noreferrer" class="ext-link">[ view live ]</a>
        )}

        {project.data.externalLinkMobile && (
          <a href={project.data.externalLinkMobile} target="_blank" rel="noopener noreferrer" class="ext-link ext-link-mobile">[ view mobile ]</a>
        )}

        <div class="detail-content">
          <Content />
        </div>
      </div>
    </div>

    {hasSiblings && (
      <nav class="project-nav" aria-label="Project navigation">
        {prevProject && (
          <a class="project-nav-link" href={`/projects/${slugOf(prevProject)}/`} rel="prev">
            <span class="project-nav-dir">← prev</span>
            <span class="project-nav-title">{prevProject.data.title}</span>
          </a>
        )}
        {nextProject && (
          <a class="project-nav-link project-nav-next" href={`/projects/${slugOf(nextProject)}/`} rel="next">
            <span class="project-nav-dir">next →</span>
            <span class="project-nav-title">{nextProject.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .detail-page {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .project-nav {
    display: flex;
    gap: 10px;
    margin-top: 24px;
  }

  .project-nav-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    min-width: 0;
    font-family: var(--font-mono);
    text-decoration: none;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .project-nav-link:hover,
  .project-nav-link:focus-visible {
    border-color: var(--accent-green);
    background: var(--bg-tertiary);
    box-shadow: 0 0 12px var(--accent-green-glow);
    outline: none;
  }

  .project-nav-next {
    align-items: flex-end;
    text-align: right;
  }

  .project-nav-dir {
    font-size: var(--fs-2xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-green);
  }

  .project-nav-title {
    max-width: 100%;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-nav-link:hover .project-nav-title,
  .project-nav-link:focus-visible .project-nav-title {
    color: var(--text-primary);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 20px;
    color: var(--text-secondary);
    font-size: var(--fs-sm);
  }

  .back-link:hover {
    color: var(--accent-green);
  }

  .detail-body {
    padding: 28px;
  }

  .detail-cover {
    margin: -28px -28px 28px;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border);
  }

  .detail-cover img,
  .detail-cover video {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(40%) contrast(1.1);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .meta-row {
    font-size: var(--fs-xs);
  }

  .meta-row .field-label {
    color: var(--accent-green);
    margin-right: 6px;
  }

  .field-value {
    color: var(--text-primary);
  }

  .ext-link {
    display: inline-block;
    margin: 8px 0 28px;
    color: var(--accent-purple);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: var(--fs-sm);
  }

  .detail-content {
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 6vw, 4.5rem);
    font-size: var(--fs-base);
    line-height: 1.8;
  }

  .detail-content > :first-child {
    margin-top: 0;
  }

  .case-section {
    padding-top: 28px;
    border-top: 1px dashed var(--border);
  }

  .case-section:first-child {
    padding-top: 0;
    border-top: none;
  }

  .detail-content h2 {
    color: var(--text-primary);
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  .detail-content h2::before {
    content: '## ';
    color: var(--accent-green);
    font-weight: 500;
  }

  .detail-content h3 {
    color: var(--accent-green);
    font-size: var(--fs-sm);
    font-weight: 500;
    margin: 28px 0 10px;
    padding-left: 14px;
    border-left: 3px solid var(--accent-green-dim);
  }

  .detail-content h3::before {
    content: '### ';
    color: var(--accent-green-dim);
  }

  .detail-content p {
    margin-bottom: 14px;
    color: var(--text-secondary);
  }

  .detail-content ul,
  .detail-content ol {
    margin: 0 0 18px;
    padding-left: 24px;
    color: var(--text-secondary);
  }

  .detail-content ul {
    list-style: none;
  }

  .detail-content li {
    margin-bottom: 6px;
    position: relative;
    padding-left: 4px;
  }

  .detail-content ul li::before {
    content: '›';
    position: absolute;
    left: -18px;
    color: var(--accent-purple);
  }

  .detail-content li > p {
    margin-bottom: 6px;
  }

  .detail-content strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  .detail-content a {
    color: var(--accent-purple);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .detail-content code {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    padding: 2px 5px;
    font-size: 0.85em;
    color: var(--accent-green);
  }

  .detail-content img {
    width: 100%;
    height: auto;
    margin: clamp(1.75rem, 4vw, 3.5rem) 0 28px;
    padding: 6px;
    border: 1px solid var(--border);
    background: var(--bg-tertiary);
    filter: grayscale(40%) contrast(1.1);
  }

  @media (max-width: 1099px) {
    .project-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 8200;
      gap: 0;
      margin: 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      border-top: 1px solid var(--border);
      background: var(--bg-tertiary);
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.35);
    }

    .project-nav-link {
      padding: 10px 14px;
      gap: 2px;
      border: none;
      background: transparent;
    }

    .project-nav-link + .project-nav-link {
      border-left: 1px solid var(--border);
    }

    .project-nav-link:hover,
    .project-nav-link:focus-visible {
      background: var(--bg-surface);
      box-shadow: none;
    }
  }

  @media (max-width: 640px) {
    .detail-body {
      padding: 14px;
    }

    .detail-cover {
      margin: -14px -14px 22px;
    }
  }
</style>

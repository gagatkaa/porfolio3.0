<section class="hero-header" id="hero-header">
  <div class="hero-header-content">
    <h1 class="hero-name" id="hero-name-display">
      <span class="name-line name-line-1" data-text="AGATA">AGATA</span>
      <span class="name-line name-line-2" data-text="TOMASZEWSKA">TOMASZEWSKA</span>
    </h1>
    <div class="hero-title-line" id="hero-title-line">
      <span class="title-bracket">[</span>
      <span class="title-text" id="title-text"></span>
      <span class="title-bracket">]</span>
    </div>
    <p class="hero-hint" id="hero-hint">
      <span class="hint-comment"># explore the portfolio —</span>
      <span class="hint-desktop">use the terminal or press the icons to open sections</span>
      <span class="hint-mobile">press the icons on the bottom to start exploring</span>
    </p>
    <button class="open-terminal-btn" id="open-terminal-btn" aria-label="Open terminal">
      <span class="btn-arrow">&gt;</span>
      <span class="btn-text">open terminal</span>
      <span class="btn-cursor">_</span>
    </button>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const nameDisplay = document.getElementById('hero-name-display');
  const titleLine = document.getElementById('hero-title-line');
  const terminalBtn = document.getElementById('open-terminal-btn');
  const hint = document.getElementById('hero-hint');

  function typeSubtitle(el, text, speed) {
    let i = 0;
    el.textContent = '';
    const cursor = document.createElement('span');
    cursor.className = 'typing-cursor';
    cursor.textContent = '▊';
    el.parentNode.insertBefore(cursor, el.nextSibling);
    function tick() {
      if (i < text.length) {
        el.textContent += text[i];
        i++;
        setTimeout(tick, speed);
      } else {
        cursor.style.animation = 'none';
        cursor.style.opacity = '0';
      }
    }
    setTimeout(tick, speed);
  }

  function animateHeader() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const titleText = document.getElementById('title-text');

    if (prefersReduced) {
      titleText.textContent = 'Digital Designer';
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.fromTo(nameDisplay, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8 })
      .fromTo('.name-line-1', { x: -30 }, { x: 0, duration: 0.5 }, '-=0.4')
      .fromTo('.name-line-2', { x: 30 }, { x: 0, duration: 0.5 }, '-=0.3')
      .fromTo(titleLine, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.4 }, '-=0.2')
      .call(() => { typeSubtitle(titleText, 'Digital Designer', 55); }, [], '>')
      .fromTo(hint, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' }, '-=0.1')
      .fromTo(terminalBtn, { opacity: 0, y: 16, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: 'power3.out' }, '-=0.1');
  }

  terminalBtn.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-terminal'));
    const terminal = document.getElementById('hero-section');
    if (terminal) {
      terminal.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  document.addEventListener('boot-complete', animateHeader, { once: true });
</script>


    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 44px;
    z-index: 8000;
    background: var(--bg-tertiary);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 6px;
    font-size: var(--fs-sm);
  }

  .taskbar-left,
  .taskbar-right {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .taskbar-left {
    flex: 1;
    min-width: 0;
  }

  :global(.taskbar-tabs) {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 8px;
    padding-left: 8px;
    border-left: 1px solid var(--border);
    min-width: 0;
    overflow: hidden;
  }

  :global(.tab-btn) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    height: 32px;
    max-width: 160px;
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    cursor: pointer;
    transition: background 0.1s, border-color 0.2s;
    flex-shrink: 0;
  }

  :global(.tab-btn .tab-label) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.tab-btn:hover),
  :global(.tab-btn:focus-visible) {
    background: var(--bg-tertiary);
    border-color: var(--accent-green);
    outline: none;
  }

  :global(.tab-btn.active) {
    color: var(--accent-green);
    border-color: var(--accent-green);
    box-shadow: 0 0 8px rgba(0, 255, 65, 0.1);
  }

  :global(.tab-close) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    font-size: 0.9rem;
    line-height: 1;
    color: var(--accent-purple);
    background: transparent;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  :global(.tab-close:hover) {
    color: #fff;
    background: #ff5f56;
  }

  .start-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 14px;
    height: 32px;
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    color: var(--accent-green);
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    cursor: pointer;
    transition: background 0.1s, border-color 0.2s;
  }

  .start-btn:hover,
  .start-btn:focus-visible {
    background: var(--bg-tertiary);
    border-color: var(--accent-green);
    box-shadow: 0 0 8px rgba(0, 255, 65, 0.1);
  }

  .start-icon {
    font-size: 0.75rem;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font-size: 1rem;
    color: var(--accent-green);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.1s, border-color 0.2s;
    font-family: var(--font-mono);
    line-height: 1;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: var(--bg-surface);
    border-color: var(--accent-green);
  }

  .taskbar-clock {
    padding: 4px 12px;
    height: 32px;
    display: flex;
    align-items: center;
    font-size: var(--fs-sm);
    color: var(--accent-green);
    border-left: 1px solid var(--border);
    font-family: var(--font-mono);
  }

  .start-menu {
    position: fixed;
    bottom: 48px;
    left: 6px;
    z-index: 8001;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-bottom: none;
    min-width: 200px;
    display: none;
    flex-direction: column;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .start-menu.visible {
    display: flex;
  }

  .start-menu-header {
    padding: 12px 16px 8px;
    font-size: var(--fs-sm);
    color: var(--accent-purple);
    border-bottom: 1px solid var(--border);
  }

  .start-item {
    padding: 10px 16px;
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    color: var(--text-primary);
    text-decoration: none;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: background 0.1s;
  }

  .start-item:hover,
  .start-item:focus-visible {
    background: var(--bg-surface);
    color: var(--accent-green);
  }

  .start-menu-footer {
    padding: 8px 16px 10px;
    font-size: var(--fs-2xs);
    color: var(--text-dim);
    border-top: 1px solid var(--border);
    margin-top: 4px;
  }

  @media (max-width: 640px) {
    .taskbar {
      height: 38px;
      font-size: 0.75rem;
      padding-bottom: env(safe-area-inset-bottom, 0);
    }

    .start-btn {
      font-size: 0.78rem;
      padding: 3px 10px;
      height: 28px;
    }

    .theme-toggle {
      width: 28px;
      height: 28px;
      font-size: 0.85rem;
    }

    .taskbar-clock {
      font-size: 0.72rem;
      padding: 3px 8px;
      height: 28px;
    }

    :global(.taskbar-tabs) {
      margin-left: 6px;
      padding-left: 6px;
      gap: 3px;
    }

    :global(.tab-btn) {
      height: 28px;
      padding: 3px 10px;
      font-size: 0.72rem;
      max-width: 120px;
    }

    .start-menu {
      min-width: 170px;

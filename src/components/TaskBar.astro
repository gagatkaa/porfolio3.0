    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 4px;
    font-size: 0.75rem;
  }

  .taskbar-left,
  .taskbar-right {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .taskbar-left {
    flex: 1;
  }

  .start-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 2px 10px;
    height: 28px;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--accent-green);
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    cursor: pointer;
    transition: background 0.1s;
  }

  .start-btn:hover,
  .start-btn:focus-visible {
    background: var(--bg-tertiary);
    border-color: var(--accent-green);
  }

  .taskbar-clock {
    padding: 2px 10px;
    height: 28px;
    display: flex;
    align-items: center;
    font-size: 0.72rem;
    color: var(--accent-green);
    border-left: 1px solid var(--border);
    margin-left: 4px;
    font-family: var(--font-mono);
  }

  .start-menu {
    position: fixed;
    bottom: 40px;
    left: 4px;
    z-index: 8001;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-bottom: none;
    min-width: 180px;
    display: none;
    flex-direction: column;
  }

  .start-menu.visible {
    display: flex;
  }

  .start-menu-header {
    padding: 10px 14px 6px;
    font-size: 0.8rem;
    color: var(--accent-purple);
    border-bottom: 1px solid var(--border);
  }

  .start-item {
    padding: 8px 14px;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--text-primary);
    text-decoration: none;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: background 0.1s;
  }

  .start-item:hover,
  .start-item:focus-visible {
    background: var(--bg-surface);
    color: var(--accent-green);
  }

  .start-menu-footer {
    padding: 6px 14px 8px;

<div class="hero-section section" id="hero-section" style="display: none;">
  <div class="terminal-window" id="main-terminal">
    <div class="terminal-titlebar">
      <span class="terminal-dots">
        <span class="dot close"></span>
        <span class="dot minimize"></span>
        <span class="dot maximize"></span>
      </span>
      <span class="terminal-title">user@portfolio: ~ — bash — 80×24</span>
    </div>
    <div class="terminal-body" id="terminal-body" tabindex="0">
      <pre id="hero-output">
<span class="terminal-prompt">user@portfolio:~$</span> <span class="terminal-command">whoami</span>
<span class="terminal-output" id="hero-name"></span>
<span class="terminal-prompt">user@portfolio:~$</span> <span class="terminal-command">echo $ROLE</span>
<span class="terminal-output" id="hero-role"></span>
<span class="terminal-output" id="hero-prompt"></span></pre>

      <div id="terminal-interactive" style="display: none;">
        <div id="terminal-history"></div>
        <div class="input-line" id="input-line">
          <span class="terminal-prompt">user@portfolio:~$</span>
          <span id="typed-text"></span>
          <span class="cursor-blink" id="cursor">▊</span>
        </div>
      </div>
    </div>
  </div>
  <input type="text" id="terminal-input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
</div>

<script>
  import gsap from 'gsap';

  const terminal = document.getElementById('main-terminal');
  const nameEl = document.getElementById('hero-name');
  const roleEl = document.getElementById('hero-role');
  const heroPrompt = document.getElementById('hero-prompt');
  const heroOutput = document.getElementById('hero-output');
  const terminalInteractive = document.getElementById('terminal-interactive');
  const terminalHistory = document.getElementById('terminal-history');
  const typedText = document.getElementById('typed-text');
  const cursor = document.getElementById('cursor');
  const hiddenInput = document.getElementById('terminal-input');
  const terminalBody = document.getElementById('terminal-body');

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cmdBuffer = '';
  let isInteractive = false;
  let cmdHistory = [];
  let historyIndex = -1;
  const bootTime = Date.now();

  function typeText(el, text, cb) {
    if (prefersReduced) {
      el.textContent = text;
      if (cb) cb();
      return;
    }
    let i = 0;
    el.textContent = '';
    const interval = setInterval(() => {
      el.textContent += text[i];
      i++;
      if (i >= text.length) {
        clearInterval(interval);
        if (cb) cb();
      }
    }, 35);
  }

  function addHistory(cmd, output, type) {
    const line = document.createElement('div');
    line.className = 'history-item';
    line.innerHTML = `<span class="terminal-prompt">user@portfolio:~$</span> <span class="terminal-command">${escapeHtml(cmd)}</span>`;
    terminalHistory.appendChild(line);
    if (output !== undefined && output !== null) {
      const outLine = document.createElement('div');
      outLine.className = 'history-output';
      if (typeof output === 'string') {
        outLine.innerHTML = type === 'html' ? output : output.replace(/\n/g, '<br>');
      }
      terminalHistory.appendChild(outLine);
    }
    terminalHistory.scrollTop = terminalHistory.scrollHeight;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function revealSection(id) {
    const el = document.getElementById(id);
    if (!el) return;
    if (id === 'hero-section') {
      document.dispatchEvent(new CustomEvent('open-terminal'));
      el.style.display = 'block';
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
    el.classList.remove('hidden-section');
    if (id === 'about-section') {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (!prefersReduced) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(20px)';
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: 'power3.out',
        onComplete: () => {
          el.style.opacity = '';
          el.style.transform = '';
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        },
      });
    } else {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    if (id === 'about-section' || id === 'projects-section' || id === 'contact-section') {
      document.dispatchEvent(new CustomEvent('section-opened', { detail: { id } }));
    }
  }
  window.revealSection = revealSection;

  const HELP_HTML = [
    '',
    '  <div class="help-title">Available commands:</div>',
    '  <div class="help-divider">&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;</div>',
    '  <div class="help-row"><span class="help-cmd">about</span>    <span class="help-dash">&mdash;</span> <span class="help-desc">Open about section</span></div>',
    '  <div class="help-row"><span class="help-cmd">projects</span> <span class="help-dash">&mdash;</span> <span class="help-desc">Open projects</span></div>',
    '  <div class="help-row"><span class="help-cmd">contact</span>  <span class="help-dash">&mdash;</span> <span class="help-desc">Open contact info</span></div>',
    '  <div class="help-row"><span class="help-cmd">clear</span>    <span class="help-dash">&mdash;</span> <span class="help-desc">Clear terminal</span></div>',
    '  <div class="help-row"><span class="help-cmd">ls</span>       <span class="help-dash">&mdash;</span> <span class="help-desc">List sections</span></div>',
    '  <div class="help-row"><span class="help-cmd">help</span>     <span class="help-dash">&mdash;</span> <span class="help-desc">Show this message</span></div>',
    '',
  ].join('\n');

  function processCommand(cmd) {
    const trimmed = cmd.trim();
    if (!trimmed) return '';

    const parts = trimmed.split(/\s+/);
    const command = parts[0].toLowerCase();

    switch (command) {
      case 'help':
        return { output: HELP_HTML, type: 'html' };
      case 'about':
        revealSection('about-section');
        return 'Opening about section...';
      case 'projects':
        revealSection('projects-section');
        return 'Opening projects section...';
      case 'contact':
        revealSection('contact-section');
        return 'Opening contact section...';
      case 'clear':
        terminalHistory.innerHTML = '';
        return '__CLEAR_ONLY__';
      case 'whoami':
        return 'Agata Tomaszewska';
      case 'echo': {
        const arg = parts.slice(1).join(' ');
        if (arg === '$ROLE' || arg === 'ROLE') return 'Digital Designer';
        return arg;
      }
      case 'date': {
        const now = new Date();
        return now.toLocaleString('en-US', {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          timeZoneName: 'short',
        });
      }
      case 'ls':
        return 'about/  projects/  contact/';
      case 'cat': {
        const arg = parts.slice(1).join(' ');
        if (arg === 'about') {
          return { output: [
            '',
            '  Agata Tomaszewska',
            '  Digital Designer',
            '  ─────────────────────────────────',
            '  Multidisciplinary designer working at the',
            '  intersection of visual identity, editorial',
            '  design, web experiences, and creative tech.',
            '',
            '  Craft: brand identity, typographic systems,',
            '  interactive installations, web development.',
            '',
          ].join('\n'), type: 'html' };
        }
        return { output: `cat: ${arg}: No such file or directory`, type: 'text' };
      }
      case 'pwd':
        return '/home/agata/portfolio';
      case 'hostname':
        return 'portfolio';
      case 'uptime': {
        const seconds = Math.floor((Date.now() - bootTime) / 1000);
        const mins = Math.floor(seconds / 60);
        const hrs = Math.floor(mins / 60);
        if (hrs > 0) return `up ${hrs} hour${hrs > 1 ? 's' : ''}, ${mins % 60} minute${mins % 60 !== 1 ? 's' : ''}`;
        return `up ${mins} minute${mins !== 1 ? 's' : ''}`;
      }
      case 'history':
        if (cmdHistory.length === 0) return 'No commands in history.';
        return cmdHistory.map((c, i) => `  ${i + 1}  ${c}`).join('\n');
      case 'sudo':
        return [
          '',
          '  Sorry, user agata is not allowed to execute',
          '  \'sudo\' as root on portfolio.local.',
          '  This incident will be reported.',
          '',
        ].join('\n');
      default:
        return `zsh: command not found: ${trimmed.split(/\s+/)[0]}`;
    }
  }

  function processAndRecord(cmd) {
    const trimmed = cmd.trim();
    if (trimmed) {
      cmdHistory.push(trimmed);
    }
    historyIndex = cmdHistory.length;
    let result = processCommand(cmd);
    if (typeof result === 'string') {
      result = { output: result, type: 'text' };
    }
    return result;
  }

  function handleCommand(cmd) {
    const result = processAndRecord(cmd);
    if (result.output === '__CLEAR_ONLY__') return;
    addHistory(cmd, result.output, result.type);
  }

  function enterInteractiveMode() {
    terminalInteractive.style.display = 'block';
    isInteractive = true;
    focusInput();
  }

  function focusInput() {
    hiddenInput.focus();
  }

  function updateTypedDisplay() {
    typedText.textContent = cmdBuffer;
  }

  hiddenInput.addEventListener('input', () => {
    cmdBuffer = hiddenInput.value;
    updateTypedDisplay();
  });

  hiddenInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const cmd = cmdBuffer;
      cmdBuffer = '';
      hiddenInput.value = '';
      updateTypedDisplay();
      handleCommand(cmd);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (cmdHistory.length > 0) {
        historyIndex = Math.max(0, historyIndex - 1);
        cmdBuffer = cmdHistory[historyIndex] || '';
        hiddenInput.value = cmdBuffer;
        updateTypedDisplay();
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (historyIndex < cmdHistory.length - 1) {
        historyIndex++;
        cmdBuffer = cmdHistory[historyIndex] || '';
      } else {
        historyIndex = cmdHistory.length;
        cmdBuffer = '';
      }
      hiddenInput.value = cmdBuffer;
      updateTypedDisplay();
    }
  });

  terminalBody.addEventListener('click', focusInput);

  document.addEventListener('keydown', (e) => {
    if (isInteractive && !e.ctrlKey && !e.metaKey && !e.altKey && e.key !== 'Tab') {
      const inAbout = document.activeElement?.closest('#about-section');
      if (document.activeElement !== hiddenInput && !inAbout) {
        focusInput();
      }
    }
  });

  function startHero() {
    const heroSection = document.getElementById('hero-section');
    if (heroSection) heroSection.style.display = 'block';

    if (!prefersReduced) {
      gsap.from(terminal,
        {
          opacity: 0, scale: 0.85, y: 30,
          duration: 0.6, ease: 'back.out(1.7)',
        }
      );
    }

    typeText(nameEl, 'Agata Tomaszewska', () => {
      setTimeout(() => {
        typeText(roleEl, 'Digital Designer', () => {
          setTimeout(() => {
            typeText(heroPrompt, '→ Type \'help\' to explore', () => {
              setTimeout(() => {
                enterInteractiveMode();
              }, 400);
            });
          }, 400);
        });
      }, 300);
    });
  }

  document.addEventListener('open-terminal', startHero, { once: true });
</script>

<style>
  .hero-section {
    padding-top: 60px;
    padding-bottom: 40px;
  }

  #main-terminal {
    box-shadow:
      0 0 0 1px var(--border-light),
      0 12px 48px rgba(0, 0, 0, 0.5);
  }

  #terminal-body {
    cursor: text;
    min-height: 200px;
  }

  #terminal-body:focus-within {
    outline: none;
  }

  #terminal-interactive {
    display: none;
  }

  #terminal-history {
    margin-bottom: 4px;
  }

  .history-item {
    line-height: 1.7;
  }

  .history-output {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 4px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .help-title {
    color: var(--accent-purple);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .help-divider {
    color: var(--text-dim);
    font-size: 0.75rem;
    margin-bottom: 6px;
  }

  .help-row {
    line-height: 1.5;
    margin-bottom: 1px;
  }

  .help-cmd {
    color: var(--accent-green);
    font-size: 0.8rem;
  }

  .help-dash {
    color: var(--text-dim);
    font-size: 0.75rem;
    margin: 0 4px;
  }

  .help-desc {
    color: var(--text-dim);
    font-size: 0.72rem;
  }

  .help-welcome {
    color: var(--accent-purple);
    font-size: 0.85rem;
  }

  .help-hint {
    color: var(--text-dim);
    font-size: 0.72rem;
  }

  .input-line {
    display: flex;
    align-items: center;
    gap: 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  #typed-text {
    color: var(--text-primary);
    white-space: pre;
  }

  .cursor-blink {
    color: var(--accent-green);
    animation: blink 1s step-end infinite;
    margin-left: 2px;
  }

  #terminal-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
    left: -9999px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-blink {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 48px;
    }

    .history-output {
      font-size: 0.75rem;
    }

    .input-line {
      font-size: 0.75rem;
    }

    .help-cmd {
      font-size: 0.72rem;
    }

    .help-desc {
      font-size: 0.65rem;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectWindow from './ProjectWindow.astro';

const projects = await getCollection('projects');

const projectsData = projects.map(p => ({
  slug: p.id.replace(/\.(md|mdx)$/, ''),
  title: p.data.title,
  shortDescription: p.data.shortDescription,
  role: p.data.role,
  year: p.data.year,
  tools: p.data.tools,
  externalLink: p.data.externalLink,
}));
---

<section class="projects-section section hidden-section" id="projects-section">
  <div class="terminal-window projects-terminal">
    <div class="terminal-titlebar">
      <span class="terminal-dots">
        <span class="dot close"></span>
        <span class="dot minimize"></span>
        <span class="dot maximize"></span>
      </span>
      <span class="terminal-title">projects — bash</span>
    </div>
    <div class="terminal-body">
      <pre><span class="terminal-prompt">user@portfolio:~$</span> <span class="terminal-command">ls -la projects/</span>
<span class="terminal-output">total {projects.length}
{projects.map((p, i) => `${String(i + 1).padStart(3)}  drwxr-xr-x  2 user  staff  1024  draft  ${p.data.title.toLowerCase().replace(/\s+/g, '-')}`).join('\n')}</span></pre>
    </div>
  </div>

  <div class="projects-grid">
    {projects.map((project, index) => (
      <ProjectCard title={project.data.title} index={index} />
    ))}
  </div>
</section>

<ProjectWindow />

<script define:vars={{ pd: projectsData }}>window.__pd = pd;</script>

<script>
  import gsap from 'gsap';

  const projectsData = window.__pd;

  const overlay = document.getElementById('project-window-overlay');
  const windowEl = document.getElementById('project-window');
  const titleEl = document.getElementById('window-title');
  const bodyEl = document.getElementById('window-body');
  const closeBtn = document.getElementById('window-close-btn');
  const dragHandle = document.getElementById('window-drag-handle');
  const cards = document.querySelectorAll('.project-card');

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let isOpen = false;
  let isDragging = false;
  let dragStartX, dragStartY, winStartX, winStartY;

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const index = parseInt(card.dataset.projectIndex);
      openProject(index);
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const index = parseInt(card.dataset.projectIndex);
        openProject(index);
      }
    });
  });

  function openProject(index) {
    const p = projectsData[index];
    if (!p) return;

    titleEl.textContent = p.title;

    bodyEl.innerHTML = `
      <div class="field"><span class="field-label">role</span><span class="field-value">${escHtml(p.role)}</span></div>
      <div class="field"><span class="field-label">year</span><span class="field-value">${p.year}</span></div>
      <div class="field"><span class="field-label">tools</span><span class="field-value">${p.tools.map(t => `<span class="tool-tag">${escHtml(t)}</span>`).join('')}</span></div>
      ${p.shortDescription ? `<div class="description">${escHtml(p.shortDescription)}</div>` : ''}
      ${p.externalLink ? `<a href="${escHtml(p.externalLink)}" target="_blank" rel="noopener noreferrer" class="ext-link">[ view live ]</a>` : ''}
      <div class="field" style="margin-top:16px">
        <a href="/projects/${escHtml(p.slug)}" class="ext-link">[ view full case study → ]</a>
      </div>
    `;

    overlay.classList.add('visible');

    if (!prefersReduced) {
      gsap.fromTo(windowEl,
        { scale: 0.7, opacity: 0, y: 30 },
        { scale: 1, opacity: 1, y: 0, duration: 0.35, ease: 'back.out(1.5)' }
      );
    }

    isOpen = true;
    resetWindowPosition();
    document.addEventListener('keydown', handleKeydown);
    overlay.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeProject() {
    if (!isOpen) return;

    document.removeEventListener('keydown', handleKeydown);
    document.body.style.overflow = '';

    if (!prefersReduced) {
      gsap.to(windowEl, {
        scale: 0.7,
        opacity: 0,
        y: 30,
        duration: 0.25,
        ease: 'power2.in',
        onComplete: () => {
          overlay.classList.remove('visible');
          windowEl.style.transform = '';
        },
      });
    } else {
      overlay.classList.remove('visible');
    }

    isOpen = false;
  }

  function handleKeydown(e) {
    if (e.key === 'Escape') {
      closeProject();
      return;
    }
    if (e.key === 'Tab') {
      const focusable = overlay.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  closeBtn.addEventListener('click', closeProject);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeProject();
  });

  function resetWindowPosition() {
    windowEl.style.left = '';
    windowEl.style.top = '';
    windowEl.style.transform = '';
  }

  function escHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  dragHandle.addEventListener('mousedown', (e) => {
    if (window.innerWidth <= 640) return;
    e.preventDefault();
    isDragging = true;
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    const rect = windowEl.getBoundingClientRect();
    winStartX = rect.left;
    winStartY = rect.top;
  });

  document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    const dx = e.clientX - dragStartX;
    const dy = e.clientY - dragStartY;
    windowEl.style.left = `${winStartX + dx}px`;
    windowEl.style.top = `${winStartY + dy}px`;
    windowEl.style.transform = 'none';
  });

  document.addEventListener('mouseup', () => {
    isDragging = false;
  });

  dragHandle.addEventListener('touchstart', (e) => {
    if (window.innerWidth <= 640) return;
    const touch = e.touches[0];
    isDragging = true;
    dragStartX = touch.clientX;
    dragStartY = touch.clientY;
    const rect = windowEl.getBoundingClientRect();
    winStartX = rect.left;
    winStartY = rect.top;
  }, { passive: true });

  document.addEventListener('touchmove', (e) => {
    if (!isDragging) return;
    const touch = e.touches[0];
    const dx = touch.clientX - dragStartX;
    const dy = touch.clientY - dragStartY;
    windowEl.style.left = `${winStartX + dx}px`;
    windowEl.style.top = `${winStartY + dy}px`;
    windowEl.style.transform = 'none';
  }, { passive: true });

  document.addEventListener('touchend', () => {
    isDragging = false;
  }, { passive: true });
</script>

<style>
  .projects-section {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .projects-terminal {
    margin-bottom: 32px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
    justify-items: center;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 4px;
    }
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
